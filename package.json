{
  "name": "@karaka/root",
  "version": "0.1.0",
  "private": true,
  "description": "Cordis foundation for composable SaaS runtimes",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "tsc -b && tsdown",
    "typecheck": "tsc -b && tsc -p tsconfig.tests.json",
    "lint": "oxlint . --deny-warnings",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "example": "node examples/foundation/run.mjs",
    "docs:record": "node scripts/record-docs.mjs",
    "docs:check": "node scripts/verify-docs.mjs",
    "verify:scope": "node scripts/verify-scope.mjs",
    "verify:packages": "node scripts/verify-packages.mjs",
    "verify:packed": "node scripts/verify-packed.mjs",
    "publint": "pnpm -r --filter './vendor/*' --filter './packages/*' exec publint",
    "verify": "pnpm run build && pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run example && pnpm run docs:check && pnpm run verify:scope && pnpm run verify:packages && pnpm run publint",
    "release:pack": "node scripts/release.mjs pack",
    "release:publish": "node scripts/release.mjs publish"
  },
  "devDependencies": {
    "@karaka/cordis": "workspace:^",
    "@karaka/cordis-plugin-hmr": "workspace:^",
    "@karaka/cordis-plugin-include": "workspace:^",
    "@karaka/cordis-plugin-loader": "workspace:^",
    "@karaka/cordis-plugin-timer": "workspace:^",
    "@types/babel__code-frame": "^7.27.0",
    "@types/node": "^22.20.0",
    "@types/picomatch": "^3.0.2",
    "@vitest/coverage-v8": "^4.1.8",
    "esbuild": "^0.28.1",
    "oxlint": "1.76.0",
    "publint": "^0.3.21",
    "tsdown": "^0.22.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
