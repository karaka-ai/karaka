{
  "name": "@karaka/storage",
  "description": "Provider-neutral durable storage seam for Karaka",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/karaka-ai/karaka.git",
    "directory": "packages/storage"
  },
  "sideEffects": false,
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./local": {
      "types": "./lib/types/local.d.ts",
      "default": "./lib/local.js"
    },
    "./default": {
      "types": "./lib/types/default.d.ts",
      "default": "./lib/default.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "LICENSE"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@karaka/cordis": "workspace:^"
  },
  "dependencies": {
    "@karaka/schemastery": "workspace:^"
  }
}
