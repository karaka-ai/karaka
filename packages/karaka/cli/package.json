{
  "name": "@karaka/cli",
  "description": "Karaka agent-workspace scaffolding and dsh profile launcher",
  "version": "0.1.2-alpha.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/karaka-ai/karaka.git",
    "directory": "packages/karaka/cli"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "bin": { "karaka": "lib/bin.js" },
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./invariant": { "types": "./lib/types/invariant.d.ts", "default": "./lib/invariant.js" },
    "./package.json": "./package.json"
  },
  "files": ["lib/index.js", "lib/bin.js", "lib/invariant.js", "lib/types/**/*.d.ts"],
  "license": "MIT",
  "publishConfig": { "access": "public" },
  "dependencies": {
    "@deepseek-ai/dsh": "workspace:^",
    "@deepseek-ai/dsh-app-boot": "workspace:^",
    "@karaka/harness": "workspace:^",
    "commander": "^15.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-invariants": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-credentials": "workspace:^",
    "@deepseek-ai/dsh-invariants": "workspace:^",
    "@deepseek-ai/dsh-llm": "workspace:^",
    "@karaka/sdk": "workspace:^",
    "zod": "^4.4.3"
  }
}
