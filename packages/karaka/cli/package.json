{
  "name": "@karaka-ai/cli",
  "description": "Karaka Agent project scaffolding and runtime launcher",
  "version": "0.1.2-alpha.3",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/karaka-ai/karaka.git",
    "directory": "packages/karaka/cli"
  },
  "type": "module",
  "main": "lib/index.js",
