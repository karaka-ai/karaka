{
  "name": "@karaka-ai/agent",
  "version": "0.1.2-alpha.3",
  "private": true,
  "description": "Karaka application profile using the upstream DSH engine",
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./browser": {
      "types": "./lib/types/browser.d.ts",
      "default": "./lib/browser.js"
    },
    "./tool-policy": {
      "types": "./lib/types/tool-policy.d.ts",
      "default": "./lib/tool-policy.js"
    },
    "./tools": {
      "types": "./lib/types/tools.d.ts",
      "default": "./lib/tools.js"
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/cordis-plugin-timer": "workspace:~",
    "@deepseek-ai/dsh-session": "workspace:*",
    "@deepseek-ai/dsh-agent": "workspace:*",
    "@deepseek-ai/dsh-agent-loop": "workspace:*",
    "@deepseek-ai/dsh-tools": "workspace:*",
    "@deepseek-ai/dsh-system-prompt": "workspace:*",
    "@deepseek-ai/dsh-llm": "workspace:*",
    "@deepseek-ai/dsh-llm-deepseek": "workspace:*",
    "@deepseek-ai/dsh-llm-retry": "workspace:*",
    "@deepseek-ai/dsh-deepseek-llm-api-extensions": "workspace:*",
    "@deepseek-ai/dsh-session-log-deepseek": "workspace:*",
    "@deepseek-ai/dsh-session-persistence-jsonl": "workspace:*",
    "@deepseek-ai/dsh-session-projection": "workspace:*",
    "@deepseek-ai/dsh-session-query-sqlite": "workspace:*",
    "@deepseek-ai/dsh-storage": "workspace:*",
    "@deepseek-ai/dsh-storage-json": "workspace:*",
    "@deepseek-ai/dsh-storage-domain": "workspace:*",
    "@deepseek-ai/dsh-credentials-local": "workspace:*",
    "@deepseek-ai/dsh-host-webserver": "workspace:*",
    "@deepseek-ai/dsh-agent-preset": "workspace:*",
    "@deepseek-ai/dsh-agent-preset-registry": "workspace:*",
    "@deepseek-ai/dsh-agent-default-model": "workspace:*",
    "@deepseek-ai/dsh-typert-registry": "workspace:*",
    "@deepseek-ai/dsh-plugin-package-inventory-deepseek": "workspace:*",
    "@karaka-ai/identity": "workspace:^",
    "@karaka-ai/server-auth": "workspace:^",
    "@karaka-ai/transport-http": "workspace:^",
    "@karaka-ai/mcp-application": "workspace:^",
    "@karaka-ai/browser-auth": "workspace:^",
    "@deepseek-ai/dsh": "workspace:*",
    "@deepseek-ai/dsh-persona": "workspace:*"
  },
  "scripts": {
    "prepare:source": "node scripts/prepare-source.mjs",
    "build": "pnpm --dir ../../.. run build:lib"
  },
  "main": "lib/index.js",
  "bin": {
    "karaka-agent": "lib/bin.js"
  },
  "files": [
    "lib/**/*.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "types": "lib/types/index.d.ts"
}
