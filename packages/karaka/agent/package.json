  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "scripts": {
    "build": "node scripts/build.mjs"
  },
  "bin": {
    "karaka-agent": "lib/bin.js"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./bin": "./lib/bin.js",
    "./cordis": {
      "types": "./lib/types/cordis.d.ts",
      "default": "./lib/cordis.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./*": {
      "types": "./lib/public/*.d.ts",
      "default": "./lib/public/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.js",
    "lib/public/**/*.js",
    "lib/public/**/*.d.ts",
    "lib/public-types/**/*.d.ts",
    "lib/invariant.js",
    "lib/types/**/*.d.ts",
    "base.cordis.patch.yml",
    "cordis.patch.yml",
    "cordis.yml",
    "resources"
  ],
