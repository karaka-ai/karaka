{
  "name": "@karaka/authentication",
  "description": "Composable authentication seam for Karaka",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/karaka-ai/karaka.git",
    "directory": "packages/authentication"
  },
  "sideEffects": false,
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./oauth-client-credentials": {
      "types": "./lib/types/oauth-client-credentials.d.ts",
      "default": "./lib/oauth-client-credentials.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@karaka/cordis": "workspace:^"
  },
  "dependencies": {
    "@karaka/schemastery": "workspace:^",
    "jose": "^6.2.5"
  }
}
