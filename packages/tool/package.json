{
  "name": "@karaka/tool",
  "description": "Cordis runtime plugins for Karaka tools",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/karaka-ai/karaka.git",
    "directory": "packages/tool"
  },
  "sideEffects": false,
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "exports": {
    "./core": {
      "types": "./lib/types/core.d.ts",
      "default": "./lib/core.js"
    },
    "./mcp-server": {
      "types": "./lib/types/mcp-server.d.ts",
      "default": "./lib/mcp-server.js"
    },
    "./mcp-client": {
      "types": "./lib/types/mcp-client.d.ts",
      "default": "./lib/mcp-client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "LICENSE"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@karaka/cordis": "workspace:^"
  },
  "dependencies": {
    "@karaka/sdk": "workspace:^",
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "ajv": "^8.20.0"
  }
}
