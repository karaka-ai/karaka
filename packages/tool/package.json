{
  "name": "@karaka/tool",
  "description": "Tool authoring contracts and runtime plugins for Karaka",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/karaka-ai/karaka.git",
    "directory": "packages/tool"
  },
  "sideEffects": false,
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./core": {
      "types": "./lib/types/core.d.ts",
      "default": "./lib/core.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "LICENSE"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@karaka/cordis": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@karaka/cordis": {
      "optional": true
    }
  },
  "dependencies": {
    "ajv": "^8.20.0"
  }
}
