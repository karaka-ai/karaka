{
  "name": "@karaka/cordis-plugin-loader",
  "description": "Plugin loader for cordis",
  "version": "1.0.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/karaka-ai/karaka.git",
    "directory": "vendor/loader"
  },
  "sideEffects": false,
  "type": "module",
  "engines": { "node": "^22.19.0 || >=24.0.0" },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "src"
  ],
  "author": "Shigma <shigma10826@gmail.com>",
  "license": "MIT",
  "peerDependencies": {
    "@karaka/cordis": "workspace:^",
    "node-addon-require-builtin": "^0.1.4"
  },
  "peerDependenciesMeta": {
    "node-addon-require-builtin": {
      "optional": true
    }
  },
  "dependencies": {
    "@karaka/cosmokit": "workspace:^"
  }
}
